{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "manplay",
  "version": "0.1.0",
  "identifier": "dev.manplay.app",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "manplay",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Music library manager",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDUyQzE4QTg3MTdFQUEKUldTcWZuR29HQ3hGYyttZk42eFE4c3FEUE1TMEMvS1JCdnJHdGZlNEswMFJDclVLVmRZeDIxZUgK",
      "endpoints": [
        "https://github.com/MariosIgkiempor/manplay/releases/latest/download/latest.json"
      ]
    }
  }
}
